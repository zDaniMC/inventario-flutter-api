# Copia este archivo como .env (backend/.env). El .env NO se sube al repositorio.
PORT=3000
JWT_SECRET=cambia-este-secreto-por-una-cadena-larga-y-aleatoria
# Duración del token: 1h, 15m, 30s ... (usa 30s para demostrar la expiración)
JWT_EXPIRES_IN=1h
# Usuario inicial de pruebas (se crea solo si la tabla usuarios está vacía)
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@inventrack.com
ADMIN_PASSWORD=Admin1234
